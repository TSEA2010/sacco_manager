   "fieldtype": "Section Break",
   "label": "Connection to the Company's ERPNext (payroll deductions)",
   "collapsible": 1
  },
  {
   "fieldname": "erp_enabled",
   "fieldtype": "Check",
   "label": "Connect to Employer ERPNext"
  },
  {
   "fieldname": "erp_url",
   "fieldtype": "Data",
   "label": "ERPNext URL",
   "options": "URL",
   "depends_on": "erp_enabled",
   "description": "e.g. https://trident.m.frappe.cloud — the company's own site."
  },
  {
   "fieldname": "erp_company",
   "fieldtype": "Data",
   "label": "Company Name in that ERPNext",
   "depends_on": "erp_enabled"
  },
  {
   "fieldname": "salary_component",
   "fieldtype": "Data",
   "label": "SACCO Deduction Salary Component",
